# Local development only. Replace every CHANGE_ME value before starting.
COMPOSE_PROJECT_NAME=university-support
MYSQL_DATABASE=university_support
MYSQL_USER=support_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_PORT=5173
BACKEND_PORT=8000
VITE_API_PROXY_TARGET=http://backend:8000
GATEWAY_PORT=8080
