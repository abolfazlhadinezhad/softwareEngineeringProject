COMPOSE_PROJECT_NAME=bnut-production
MYSQL_DATABASE=bnut
MYSQL_USER=bnut_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=support.example.invalid,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://support.example.invalid
TLS_DIRECTORY=/approved/certificates
